<mxfile host="app.diagrams.net" agent="DDoS-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_cascading_dual_tier_engine" name="cascading_dual_tier_engine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Ingress Flow Vector&lt;/b&gt;&lt;br&gt;&lt;small&gt;16 Canonical Features&lt;/small&gt;&lt;hr&gt;• Rolling Shannon Entropy&lt;br&gt;• Symmetry Ratio &amp; IAT&lt;br&gt;• Packet Sizes &amp; Rates&lt;br&gt;• Extracted in 0.12 μs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="140" width="220" height="160" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Tier-1: Fast Decision Filter&lt;/b&gt;&lt;br&gt;&lt;small&gt;Histogram-Binned Quantile Tree&lt;/small&gt;&lt;hr&gt;• O(1) Evaluation per Flow&lt;br&gt;• Latency: 1.87 μs (0.0019 ms)&lt;br&gt;• CPU L2/L3 Cache Resident&lt;br&gt;• Memory Footprint: &lt; 12 MB&lt;br&gt;─────────────────────────&lt;br&gt;Decision Boundary Thresholds:&lt;br&gt;1. Clear Benign Flow: P &lt; 0.20&lt;br&gt;   ➔ Direct Pass, No GPU Overhead&lt;br&gt;2. Definite Flood Attack: P &gt; 0.85&lt;br&gt;   ➔ Immediate ACL / BGP Drop&lt;br&gt;3. Ambiguous / High-Entropy: 0.20 ≤ P ≤ 0.85&lt;br&gt;   ➔ Escalates to Deep ResNet Tier&lt;br&gt;─────────────────────────&lt;br&gt;• 83.9% Flows Resolved Immediately" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="140" width="320" height="420" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Tier-2: Deep Tabular ResNet&lt;/b&gt;&lt;br&gt;&lt;small&gt;Deep Representation Learning&lt;/small&gt;&lt;hr&gt;• Layer Normalization + GELU&lt;br&gt;• 3 Residual Skip Connection Blocks&lt;br&gt;• Dropout(0.20) Regularization&lt;br&gt;• Focal Loss (γ = 2.0)&lt;br&gt;• MPS / CUDA Hardware Acceleration&lt;br&gt;─────────────────────────&lt;br&gt;• Latency: 12.8 μs per flow&lt;br&gt;• Resolves Complex Volumetric Blends&lt;br&gt;• Detects Low-Rate Slowloris / Infiltration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#d8b4fe;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="730" y="340" width="310" height="340" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Line-Rate PASS&lt;/b&gt;&lt;br&gt;&lt;small&gt;P &amp;lt; 0.20&lt;/small&gt;&lt;hr&gt;• Immediate Egress&lt;br&gt;• 0 ms Queuing Delay" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#041f14;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="140" width="210" height="120" /></mxCell><mxCell id="node_6" value="&lt;b&gt;Fast DROP&lt;/b&gt;&lt;br&gt;&lt;small&gt;P &amp;gt; 0.85&lt;/small&gt;&lt;hr&gt;• Instant IP Cutoff&lt;br&gt;• High Flood Protection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#24070a;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="290" width="210" height="120" /></mxCell><mxCell id="node_7" value="&lt;b&gt;Policing / Honeynet&lt;/b&gt;&lt;br&gt;&lt;small&gt;Tier-2 Calibrated Verdict&lt;/small&gt;&lt;hr&gt;• Rate-Limit 50%&lt;br&gt;• Quarantine Flow" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="440" width="210" height="120" /></mxCell><mxCell id="node_8" value="&lt;b&gt;Definitive Attack Drop&lt;/b&gt;&lt;br&gt;&lt;small&gt;Tier-2 Verified Malicious&lt;/small&gt;&lt;hr&gt;• OpenFlow Rule Install&lt;br&gt;• BGP-Flowspec Scrub" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#24070a;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="590" width="210" height="120" /></mxCell><mxCell id="edge_9" value="Clear Benign (P &amp;lt; 0.20) [83.9% of flows]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;fontSize=10;" edge="1" parent="1" source="node_3" target="node_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_10" value="Definite Attack (P &amp;gt; 0.85)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontSize=10;" edge="1" parent="1" source="node_3" target="node_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_11" value="Escalation: 0.20 ≤ P ≤ 0.85" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontSize=10;" edge="1" parent="1" source="node_3" target="node_4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_12" value="Moderate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontSize=10;" edge="1" parent="1" source="node_4" target="node_7"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>