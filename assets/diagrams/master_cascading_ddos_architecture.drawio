<mxfile host="app.diagrams.net" agent="DDoS-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_master_cascading_ddos_architecture" name="master_cascading_ddos_architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="840" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Physical Adapter&lt;/b&gt;&lt;br&gt;&lt;small&gt;Ethernet / Wi-Fi Wiretap&lt;/small&gt;&lt;hr&gt;• Interface: en0 (10Gbps)&lt;br&gt;• BPF Kernel Ring Buffer&lt;br&gt;• Zero-Copy Packet Slicing&lt;br&gt;• Latency: &lt; 1.2 μs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="136" width="230" height="190" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Virtual Network Fabric&lt;/b&gt;&lt;br&gt;&lt;small&gt;SDN / Tunnels / Loopback&lt;/small&gt;&lt;hr&gt;• lo0 / lo loopback traffic&lt;br&gt;• utun0 - utun3 IPSec / WireGuard&lt;br&gt;• OpenFlow SDN Switches&lt;br&gt;• vir-sim Simulated Ingress" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="346" width="230" height="190" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Multi-Dataset PCAP / CSV&lt;/b&gt;&lt;br&gt;&lt;small&gt;Offline Research Validation&lt;/small&gt;&lt;hr&gt;• InSDN (SDN Control/Data Plane)&lt;br&gt;• CIC-DDoS2019 (Volumetric)&lt;br&gt;• CIC-IDS2017 &amp; NSL-KDD&lt;br&gt;• BoT-IoT &amp; ToN-IoT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="556" width="230" height="190" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Canonical Flow Adapter&lt;/b&gt;&lt;br&gt;&lt;small&gt;16-D Mathematical Projection&lt;/small&gt;&lt;hr&gt;• 1. Flow Duration (μs)&lt;br&gt;• 2. Total Fwd Packets&lt;br&gt;• 3. Total Bwd Packets&lt;br&gt;• 4. Fwd Pkt Length Mean&lt;br&gt;• 5. Bwd Pkt Length Mean&lt;br&gt;• 6. Flow Inter-Arrival Mean&lt;br&gt;• 7. Flow Inter-Arrival Std&lt;br&gt;• 8. Fwd Inter-Arrival Mean&lt;br&gt;• 9. Bwd Inter-Arrival Mean&lt;br&gt;• 10. Flow Packets / sec&lt;br&gt;• 11. Flow Bytes / sec&lt;br&gt;• 12. Packet Length Variance&lt;br&gt;• 13. Rolling Shannon Entropy&lt;br&gt;• 14. SYN Flag Ratio&lt;br&gt;• 15. ACK Flag Ratio&lt;br&gt;• 16. Subflow Symmetry Index&lt;br&gt;─────────────────────────&lt;br&gt;• Robust Scaler Scaling&lt;br&gt;• Cross-Dataset Alignment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#818cf8;strokeWidth=2;fontColor=#a5b4fc;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="290" y="136" width="230" height="610" /></mxCell><mxCell id="node_6" value="&lt;b&gt;Tier-1 Fast Filter&lt;/b&gt;&lt;br&gt;&lt;small&gt;Histogram-Binned Decision Tree&lt;/small&gt;&lt;hr&gt;• O(1) Quantile Bin Lookup&lt;br&gt;• Inference: 1.87 μs (0.0019 ms)&lt;br&gt;• Discharges &gt; 83.9% Benign Flows&lt;br&gt;• Zero GPU / MPS Invocation&lt;br&gt;• Memory Footprint: &lt; 12 MB&lt;br&gt;• High Throughput: 78k flows/s&lt;br&gt;─────────────────────────&lt;br&gt;Confidence Routing Logic:&lt;br&gt;• P &lt; 0.20 ➔ Pass (Benign Line-Rate)&lt;br&gt;• P &gt; 0.85 ➔ Drop (Definite Attack)&lt;br&gt;• 0.20 ≤ P ≤ 0.85 ➔ Cascade to Tier-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="136" width="270" height="290" /></mxCell><mxCell id="node_7" value="&lt;b&gt;Fast-Path Verdicts&lt;/b&gt;&lt;br&gt;&lt;small&gt;Immediate Low-Latency Actions&lt;/small&gt;&lt;hr&gt;• Direct Line-Rate Bypass&lt;br&gt;• Sub-Millisecond Forwarding&lt;br&gt;• Zero Queuing Jitter&lt;br&gt;• Offloads Deep Neural Engine&lt;br&gt;─────────────────────────&lt;br&gt;• Over 83.9% Benign Bypassed&lt;br&gt;• Rapid High-Volume Flood Cutoff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#34d399;strokeWidth=2;fontColor=#6ee7b7;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="456" width="270" height="290" /></mxCell><mxCell id="node_8" value="&lt;b&gt;Tier-2 Tabular ResNet&lt;/b&gt;&lt;br&gt;&lt;small&gt;Deep Representation Learning&lt;/small&gt;&lt;hr&gt;Triggered for Ambiguous High-Entropy Flows&lt;br&gt;─────────────────────────&lt;br&gt;• Input: 16-D Feature Vector&lt;br&gt;• Linear Input Stem (16 ➔ 128)&lt;br&gt;• Layer Normalization + GELU&lt;br&gt;─────────────────────────&lt;br&gt;Residual Block 1:&lt;br&gt;• Linear (128 ➔ 128) + Dropout(0.20)&lt;br&gt;• Skip Connection: x + F(x)&lt;br&gt;─────────────────────────&lt;br&gt;Residual Block 2:&lt;br&gt;• Linear (128 ➔ 64) with Proj Skip&lt;br&gt;• LayerNorm + GELU Activation&lt;br&gt;─────────────────────────&lt;br&gt;Residual Block 3:&lt;br&gt;• Linear (64 ➔ 64) + Skip Connection&lt;br&gt;─────────────────────────&lt;br&gt;Calibrated Output Head:&lt;br&gt;• Linear (64 ➔ 1) + Platt Scaling&lt;br&gt;• Focal Loss (γ = 2.0, α = 0.25)&lt;br&gt;• MPS / CUDA Hardware Acceleration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#d8b4fe;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="830" y="136" width="280" height="610" /></mxCell><mxCell id="node_9" value="&lt;b&gt;PASS (Benign)&lt;/b&gt;&lt;br&gt;&lt;small&gt;P &amp;lt; 0.20 | Zero Delay&lt;/small&gt;&lt;hr&gt;• Forwarding to Egress Port&lt;br&gt;• Zero State Queuing Overhead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#041f14;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="136" width="270" height="140" /></mxCell><mxCell id="node_10" value="&lt;b&gt;RATE_LIMIT_50PCT&lt;/b&gt;&lt;br&gt;&lt;small&gt;0.20 ≤ P &amp;lt; 0.60 | Leaky Bucket&lt;/small&gt;&lt;hr&gt;• Token-Bucket Traffic Policing&lt;br&gt;• Absorbs Micro-Burst Anomaly" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="292" width="270" height="140" /></mxCell><mxCell id="node_11" value="&lt;b&gt;QUARANTINE_FLOW&lt;/b&gt;&lt;br&gt;&lt;small&gt;0.60 ≤ P &amp;lt; 0.85 | Flow Isolation&lt;/small&gt;&lt;hr&gt;• Dynamic VLAN Honey-Routing&lt;br&gt;• Deep Behavioral Inspection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#f97316;strokeWidth=2;fontColor=#fb923c;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="448" width="270" height="140" /></mxCell><mxCell id="node_12" value="&lt;b&gt;BLOCK_SOURCE_IP&lt;/b&gt;&lt;br&gt;&lt;small&gt;P ≥ 0.85 | Instant Drop&lt;/small&gt;&lt;hr&gt;• OpenFlow Flow-Mod Drop Rule&lt;br&gt;• BGP-Flowspec Ingress Scrub&lt;br&gt;• Linux eBPF / XDP Blacklisting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#24070a;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="604" width="270" height="142" /></mxCell><mxCell id="edge_13" value="V-Tunnels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontSize=10;" edge="1" parent="1" source="node_3" target="node_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_14" value="P &amp;lt; 0.20 (Benign)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;fontSize=10;" edge="1" parent="1" source="node_6" target="node_9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_15" value="P &amp;gt; 0.85 (Attack)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontSize=10;" edge="1" parent="1" source="node_6" target="node_12"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f97316;strokeWidth=2;fontColor=#f97316;fontSize=10;" edge="1" parent="1" source="node_8" target="node_11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontSize=10;" edge="1" parent="1" source="node_11" target="node_12"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>