<mxfile host="app.diagrams.net" agent="DDoS-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_autonomous_mitigation_controller" name="autonomous_mitigation_controller"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Neural Confidence Score&lt;/b&gt;&lt;br&gt;&lt;small&gt;Calibrated Output P(Attack)&lt;/small&gt;&lt;hr&gt;• From Tier-1 Fast Tree OR&lt;br&gt;• From Tier-2 Deep ResNet&lt;br&gt;• Platt Temperature Scaled&lt;br&gt;─────────────────────────&lt;br&gt;Continuous Range: [0.0, 1.0]&lt;br&gt;• Low Risk: P &lt; 0.20&lt;br&gt;• Micro-Burst: 0.20 ≤ P &lt; 0.60&lt;br&gt;• Suspicious: 0.60 ≤ P &lt; 0.85&lt;br&gt;• Critical DDoS: P ≥ 0.85" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="140" width="240" height="280" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Tier A: Zero-Delay PASS&lt;/b&gt;&lt;br&gt;&lt;small&gt;P &amp;lt; 0.20 | Normal Traffic&lt;/small&gt;&lt;hr&gt;• Forwarding to OpenFlow egress port&lt;br&gt;• Zero state allocation delay&lt;br&gt;• Latency: &lt; 1.87 μs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#041f14;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="370" y="140" width="300" height="125" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Tier B: RATE_LIMIT_50PCT&lt;/b&gt;&lt;br&gt;&lt;small&gt;0.20 ≤ P &amp;lt; 0.60 | Burst Anomaly&lt;/small&gt;&lt;hr&gt;• Token-Bucket Leaky Policing (50%)&lt;br&gt;• Preserves TCP flow integrity&lt;br&gt;• Suppresses transient UDP spikes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="370" y="280" width="300" height="125" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Tier C: QUARANTINE_FLOW&lt;/b&gt;&lt;br&gt;&lt;small&gt;0.60 ≤ P &amp;lt; 0.85 | Flow Isolation&lt;/small&gt;&lt;hr&gt;• Dynamic VLAN Honey-Routing&lt;br&gt;• Diverts to deep packet capture&lt;br&gt;• Prevents lateral blast radius" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#f97316;strokeWidth=2;fontColor=#fb923c;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="370" y="420" width="300" height="125" /></mxCell><mxCell id="node_6" value="&lt;b&gt;Tier D: BLOCK_SOURCE_IP&lt;/b&gt;&lt;br&gt;&lt;small&gt;P ≥ 0.85 | Volumetric Flood&lt;/small&gt;&lt;hr&gt;• High-priority OpenFlow Flow-Mod&lt;br&gt;• Upstream BGP-Flowspec Scrubbing&lt;br&gt;• Linux eBPF / XDP Ingress Drop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#24070a;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="370" y="560" width="300" height="125" /></mxCell><mxCell id="node_7" value="&lt;b&gt;Enforcement Plane &amp;amp; SDN Fabric Real-Time Actions&lt;/b&gt;&lt;br&gt;&lt;small&gt;Multi-Layer Network Defense Deployment&lt;/small&gt;&lt;hr&gt;1. OpenFlow SDN Controller (Ryu / ONOS / OVS):&lt;br&gt;   • Sends OFPT_FLOW_MOD with OFPFC_ADD command&lt;br&gt;   • Matches: dl_type=0x0800, nw_src=ATTACK_IP, nw_dst=TARGET_IP&lt;br&gt;   • Action: OFPAT_OUTPUT = 0 (Drop packet immediately at switch hardware)&lt;br&gt;   • Priority: 65535 (Highest switch table priority)&lt;br&gt;─────────────────────────────────────────────────────────────&lt;br&gt;2. Upstream BGP-Flowspec Scrubbing (RFC 8955 / RFC 5575):&lt;br&gt;   • Injects BGP NLRI Type 13 to upstream ISP routers&lt;br&gt;   • Offloads volumetric amplification (NTP/DNS/SSDP) before reaching edge link&lt;br&gt;   • Prevents edge transit bandwidth saturation&lt;br&gt;─────────────────────────────────────────────────────────────&lt;br&gt;3. Linux eBPF / XDP Fast Path Ingress Filter:&lt;br&gt;   • Attaches XDP_DROP hook directly at network device driver level&lt;br&gt;   • Sub-microsecond packet discard before kernel sk_buff allocation&lt;br&gt;─────────────────────────────────────────────────────────────&lt;br&gt;4. OPSEC Privacy Protection &amp; Masked Telemetry:&lt;br&gt;   • Real-time IP address masking (e.g. 10.249.***.*** [INT-MASKED])&lt;br&gt;   • Zero sensitive metadata leakage in SOC logs and audit trails" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#d8b4fe;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="750" y="140" width="560" height="545" /></mxCell><mxCell id="edge_8" value="P &amp;lt; 0.20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;fontSize=10;" edge="1" parent="1" source="node_2" target="node_3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_9" value="0.20 ≤ P &amp;lt; 0.60" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontSize=10;" edge="1" parent="1" source="node_2" target="node_4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_10" value="0.60 ≤ P &amp;lt; 0.85" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f97316;strokeWidth=2;fontColor=#f97316;fontSize=10;" edge="1" parent="1" source="node_2" target="node_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_11" value="P ≥ 0.85" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontSize=10;" edge="1" parent="1" source="node_2" target="node_6"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>