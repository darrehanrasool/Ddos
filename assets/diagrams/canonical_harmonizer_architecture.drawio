<mxfile host="app.diagrams.net" agent="DDoS-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_canonical_harmonizer_architecture" name="canonical_harmonizer_architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;InSDN Dataset&lt;/b&gt;&lt;br&gt;&lt;small&gt;Software-Defined Networking&lt;/small&gt;&lt;hr&gt;• OpenFlow Switch &amp; Controller Telemetry&lt;br&gt;• 84 Native Features (TCP/UDP/ICMP Floods)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="130" width="260" height="95" /></mxCell><mxCell id="node_3" value="&lt;b&gt;CIC-DDoS2019&lt;/b&gt;&lt;br&gt;&lt;small&gt;Volumetric &amp;amp; Reflection&lt;/small&gt;&lt;hr&gt;• DNS, NTP, LDAP, NetBIOS, MSSQL, SYN&lt;br&gt;• 88 Native CICFlowMeter Features" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#818cf8;strokeWidth=2;fontColor=#a5b4fc;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="235" width="260" height="95" /></mxCell><mxCell id="node_4" value="&lt;b&gt;CIC-IDS2017&lt;/b&gt;&lt;br&gt;&lt;small&gt;Enterprise Cloud Intrusions&lt;/small&gt;&lt;hr&gt;• DoS Hulk, GoldenEye, Slowloris, Slowhttptest&lt;br&gt;• 79 Native Flow Telemetry Metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="340" width="260" height="95" /></mxCell><mxCell id="node_5" value="&lt;b&gt;NSL-KDD Dataset&lt;/b&gt;&lt;br&gt;&lt;small&gt;Legacy Protocol Defense&lt;/small&gt;&lt;hr&gt;• Smurf, Neptune, Teardrop, Pod&lt;br&gt;• 41 Legacy Connection Records" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#fbbf24;strokeWidth=2;fontColor=#fbbf24;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="445" width="260" height="95" /></mxCell><mxCell id="node_6" value="&lt;b&gt;BoT-IoT &amp;amp; ToN-IoT&lt;/b&gt;&lt;br&gt;&lt;small&gt;IoT &amp;amp; Industrial IIoT&lt;/small&gt;&lt;hr&gt;• Mirai, Gafgyt, MQTT, Modbus Floods&lt;br&gt;• Lightweight Telemetry Sensors" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#c084fc;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="550" width="260" height="95" /></mxCell><mxCell id="node_7" value="&lt;b&gt;Cross-Domain Alignment Engine&lt;/b&gt;&lt;br&gt;&lt;small&gt;Mathematical Mapping &amp;amp; Normalization&lt;/small&gt;&lt;hr&gt;• Schema Mapping Dictionary across 6 Datasets&lt;br&gt;• Zero-Imputation for Missing Protocol Fields&lt;br&gt;• Outlier Winsorization &amp; Infinite Ratio Clipping&lt;br&gt;─────────────────────────────────────────────────&lt;br&gt;Statistical Feature Generators:&lt;br&gt;• Rolling Shannon Entropy: H(X) = -∑ p(x) log₂ p(x)&lt;br&gt;• Packet Size Asymmetry: |Fwd - Bwd| / (Fwd + Bwd)&lt;br&gt;• Inter-Arrival Time (IAT) Jitter &amp; Dispersion&lt;br&gt;• SYN-to-ACK TCP Handshake Disruption Ratios&lt;br&gt;─────────────────────────────────────────────────&lt;br&gt;• Robust Scaler Scaling (Median &amp; IQR Normalized)&lt;br&gt;• Eliminates Cross-Domain Generalization Collapse" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="130" width="420" height="515" /></mxCell><mxCell id="node_8" value="&lt;b&gt;16-D Standardized Canonical Feature Vector&lt;/b&gt;&lt;br&gt;&lt;small&gt;Mathematically Coherent Across All Networks&lt;/small&gt;&lt;hr&gt; 1. flow_duration          : Microsecond duration of session&lt;br&gt; 2. total_fwd_packets      : Packets transmitted forward&lt;br&gt; 3. total_bwd_packets      : Packets received backward&lt;br&gt; 4. fwd_pkt_length_mean    : Mean payload bytes forward&lt;br&gt; 5. bwd_pkt_length_mean    : Mean payload bytes backward&lt;br&gt; 6. flow_iat_mean          : Mean inter-arrival time (jitter)&lt;br&gt; 7. flow_iat_std           : Dispersion of arrival intervals&lt;br&gt; 8. fwd_iat_mean           : Forward transmission regularity&lt;br&gt; 9. bwd_iat_mean           : Backward acknowledgement delay&lt;br&gt;10. flow_packets_per_s     : Volumetric packet throughput&lt;br&gt;11. flow_bytes_per_s       : Bandwidth saturation rate&lt;br&gt;12. pkt_length_variance    : Dispersion of packet sizes&lt;br&gt;13. packet_length_entropy  : Shannon entropy of lengths&lt;br&gt;14. syn_flag_ratio         : Ratio of SYN packets (TCP flood)&lt;br&gt;15. ack_flag_ratio         : Ratio of ACK packets (Reflection)&lt;br&gt;16. subflow_symmetry       : Directional flow balance index" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#34d399;strokeWidth=2;fontColor=#6ee7b7;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="130" width="480" height="515" /></mxCell><mxCell id="edge_9" value="Standardized 16-D" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontSize=10;" edge="1" parent="1" source="node_7" target="node_8"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>