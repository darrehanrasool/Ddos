<mxfile host="app.diagrams.net" agent="DDoS-AI Antigravity" version="24.0.0" type="device"><diagram id="diag_deep_tabular_resnet_architecture" name="deep_tabular_resnet_architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="780" background="#0a0f1d" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="node_2" value="&lt;b&gt;Input Features&lt;/b&gt;&lt;br&gt;&lt;small&gt;Canonical Normalized Flow&lt;/small&gt;&lt;hr&gt;• Input: x ∈ ℝ¹⁶&lt;br&gt;• 16 Continuous Features&lt;br&gt;• Robust Scaled&lt;br&gt;• Outlier Resilient" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="140" width="200" height="170" /></mxCell><mxCell id="node_3" value="&lt;b&gt;Input Projection Stem&lt;/b&gt;&lt;br&gt;&lt;small&gt;Feature Dimension Expansion&lt;/small&gt;&lt;hr&gt;• Linear (16 ➔ 128)&lt;br&gt;• Layer Normalization&lt;br&gt;• GELU Activation&lt;br&gt;• Output: h₀ ∈ ℝ¹²⁸" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#818cf8;strokeWidth=2;fontColor=#a5b4fc;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="140" width="220" height="170" /></mxCell><mxCell id="node_4" value="&lt;b&gt;Residual Block 1&lt;/b&gt;&lt;br&gt;&lt;small&gt;Identity Skip Connection&lt;/small&gt;&lt;hr&gt;• Linear (128 ➔ 128)&lt;br&gt;• Layer Normalization&lt;br&gt;• GELU Activation&lt;br&gt;• Dropout (p = 0.20)&lt;br&gt;─────────────────────────&lt;br&gt;• Skip: h₁ = h₀ + F₁(h₀)&lt;br&gt;• Mitigates Vanishing Gradient" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#d8b4fe;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="140" width="240" height="240" /></mxCell><mxCell id="node_5" value="&lt;b&gt;Residual Block 2&lt;/b&gt;&lt;br&gt;&lt;small&gt;Dimension Projection Skip&lt;/small&gt;&lt;hr&gt;• Linear (128 ➔ 64)&lt;br&gt;• Layer Normalization&lt;br&gt;• GELU Activation&lt;br&gt;• Dropout (p = 0.20)&lt;br&gt;─────────────────────────&lt;br&gt;• Proj Skip: W_s · h₁ + F₂(h₁)&lt;br&gt;• Dimensionality Bottleneck" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#d8b4fe;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="140" width="240" height="240" /></mxCell><mxCell id="node_6" value="&lt;b&gt;Residual Block 3&lt;/b&gt;&lt;br&gt;&lt;small&gt;Deep Non-Linear Representation&lt;/small&gt;&lt;hr&gt;• Linear (64 ➔ 64)&lt;br&gt;• Layer Normalization&lt;br&gt;• GELU Activation&lt;br&gt;• Dropout (p = 0.10)&lt;br&gt;─────────────────────────&lt;br&gt;• Skip: h₃ = h₂ + F₃(h₂)&lt;br&gt;• Output: h₃ ∈ ℝ⁶⁴" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#c084fc;strokeWidth=2;fontColor=#d8b4fe;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="140" width="220" height="240" /></mxCell><mxCell id="node_7" value="&lt;b&gt;Calibrated Decision Head &amp;amp; Objective Function&lt;/b&gt;&lt;br&gt;&lt;small&gt;Temperature-Scaled Platt Calibration &amp;amp; Focal Loss&lt;/small&gt;&lt;hr&gt;• Classification Head: Linear (64 ➔ 1)&lt;br&gt;• Platt Temperature Scaling: z / T (with T = 1.10)&lt;br&gt;• Probability: P(Attack) = σ(z / T)&lt;br&gt;────────────────────────────────────────────────────────&lt;br&gt;Focal Loss Objective Function (Class-Imbalance Mitigated):&lt;br&gt;• FL(p_t) = -α_t · (1 - p_t)^γ · log(p_t)    [γ = 2.0, α = 0.25]&lt;br&gt;• Downweights easy benign negatives; focuses gradients on rare volumetric anomalies&lt;br&gt;────────────────────────────────────────────────────────&lt;br&gt;Hardware Acceleration: Apple Silicon Metal Performance Shaders (MPS) &amp; NVIDIA CUDA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#131d33;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="440" width="520" height="260" /></mxCell><mxCell id="node_8" value="&lt;b&gt;Benign Clearance&lt;/b&gt;&lt;br&gt;&lt;small&gt;P(Attack) &amp;lt; 0.50&lt;/small&gt;&lt;hr&gt;• Normal Traffic Confirmed&lt;br&gt;• Egress Forwarding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#041f14;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="440" width="220" height="120" /></mxCell><mxCell id="node_9" value="&lt;b&gt;Attack Confirmed&lt;/b&gt;&lt;br&gt;&lt;small&gt;P(Attack) ≥ 0.50&lt;/small&gt;&lt;hr&gt;• High-Entropy DDoS Alert&lt;br&gt;• OpenFlow Mitigation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#24070a;strokeColor=#f87171;strokeWidth=2;fontColor=#f87171;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="580" width="220" height="120" /></mxCell><mxCell id="edge_10" value="x ∈ ℝ¹⁶" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontSize=10;" edge="1" parent="1" source="node_2" target="node_3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_11" value="h₀ ∈ ℝ¹²⁸" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=2;fontColor=#818cf8;fontSize=10;" edge="1" parent="1" source="node_3" target="node_4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_12" value="h₁ ∈ ℝ¹²⁸" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c084fc;strokeWidth=2;fontColor=#c084fc;fontSize=10;" edge="1" parent="1" source="node_4" target="node_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_13" value="h₂ ∈ ℝ⁶⁴" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c084fc;strokeWidth=2;fontColor=#c084fc;fontSize=10;" edge="1" parent="1" source="node_5" target="node_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_14" value="h₃ ∈ ℝ⁶⁴ Latent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34d399;strokeWidth=2;fontColor=#34d399;fontSize=10;" edge="1" parent="1" source="node_6" target="node_7"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>